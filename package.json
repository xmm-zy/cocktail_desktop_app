{
  "name": "drink-app",
  "private": true,
  "version": "0.0.0",
  "description": "Luceria Cocktail Atelier desktop application",
  "author": "Luceria Cocktail Atelier",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build": "vite build && node scripts/clean-dist.mjs",
    "build:desktop": "vite build --mode desktop && node scripts/clean-dist.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.50.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^9.29.0",
    "eslint-plugin-vue": "^10.2.0",
    "globals": "^16.2.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.luceria.cocktail",
    "productName": "Luceria Cocktail Atelier",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
